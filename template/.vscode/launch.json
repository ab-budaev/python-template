{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Uvicorn + Debug",
            "type": "debugpy",
            "request": "launch",
            "purpose": [
                "debug-in-terminal"
            ],
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "autoStartBrowser": false,
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "purpose": [
                "debug-test"
            ],
            "justMyCode": false
        }
    ]
}
