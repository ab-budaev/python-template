services:
  app:
    build:
      context: .
      target: dev
    env_file:
      - path: .env
        required: false
    environment:
      - PYTHONPATH=/opt/{{app_name}}/src
    working_dir: /opt/{{app_name}}
    command:
      - .venv/bin/uvicorn
      - main:app
      - --host
      - 0.0.0.0
      - --port
      - "8000"
      - --reload
    ports:
      - "8000:8000"
