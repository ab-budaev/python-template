import pytest
from pydantic import ValidationError

from settings import AppSettings, LogLevel


@pytest.fixture(autouse=True)
def _app_name(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("APP_NAME", "my-model")


def test_settings_from_env(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("APP_ENV", "staging")

    settings = AppSettings()
    assert settings.app_name == "my-model"
    assert settings.app_env == "staging"
    assert settings.log_level == LogLevel.INFO


def test_app_name_has_default(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.delenv("APP_NAME", raising=False)

    settings = AppSettings()
    assert settings.app_name == "{{app_name}}"


@pytest.mark.parametrize(
    "value,expected",
    [
        ("DEBUG", LogLevel.DEBUG),
        ("debug", LogLevel.DEBUG),
        ("INFO", LogLevel.INFO),
        ("info", LogLevel.INFO),
        ("WARNING", LogLevel.WARNING),
        ("ERROR", LogLevel.ERROR),
    ],
)
def test_log_level_accepts_names(monkeypatch: pytest.MonkeyPatch, value: str, expected: LogLevel) -> None:
    monkeypatch.setenv("LOG_LEVEL", value)
    assert AppSettings().log_level == expected


@pytest.mark.parametrize("value", ["10", "50", "DEBUG2", ""])
def test_log_level_rejects_invalid(monkeypatch: pytest.MonkeyPatch, value: str) -> None:
    monkeypatch.setenv("LOG_LEVEL", value)
    with pytest.raises(ValidationError):
        AppSettings()


def test_env_defaults_to_local(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.delenv("APP_ENV", raising=False)

    settings = AppSettings()
    assert settings.app_env == "local"


def test_settings_subclass_extends(monkeypatch: pytest.MonkeyPatch) -> None:
    class MySettings(AppSettings):
        model_dir: str = "/data/model_files"

    settings = MySettings()
    assert settings.app_name == "my-model"
    assert settings.model_dir == "/data/model_files"


def test_otel_disabled_by_default() -> None:
    settings = AppSettings()
    assert settings.otel.sdk_disabled is True
